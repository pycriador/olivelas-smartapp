# ==============================================================================
# Olivelas SmartApp / App Builder Engine - Environment Configuration Template
# NOTE: Never commit .env with real credentials to Git. Use this template.
# ==============================================================================

# Server Runtime
APP_ENV=development
API_PORT=8000
API_HOST=127.0.0.1
LOG_LEVEL=INFO

# Supabase Frontend Configuration (Public / Publishable Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_SCHEMA=olivelas_smartapp

# Supabase PostgreSQL Backend Configuration (Isolated Schema)
db_host=db.your-project-ref.supabase.co
db_port=5432
db=postgres
db_username=postgres
username=postgres
db_password=your-supabase-db-password
DB_SCHEMA=olivelas_smartapp
DATABASE_URL=postgresql+psycopg2://postgres:your-supabase-db-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# IAM & Security Keys (Generate strong random keys for production)
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars
ENCRYPTION_KEY=your-secure-encryption-key-for-credentials-32b

# Optional AI Gateway Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

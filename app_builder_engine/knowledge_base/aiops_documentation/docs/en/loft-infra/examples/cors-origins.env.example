# Example — production CORS_ORIGINS for AIOps FastAPI (Vault / backend/.env)
#
# Rules:
# - Exact browser Origin (scheme + host [+ port]), comma-separated
# - No trailing slash
# - https for published hosts
# - API reads CORS_ORIGINS at startup → change requires pod restart
#
# Prefer values from deploy/published-hosts.env (CORP_FRONT_URL, CROSS_FRONT_URL).

CORS_ORIGINS=https://<app>.loft-corp.com.br,https://<front-name>.cross.loft-prod.io

# Local-only (do not rely on these in Vault prod):
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# Minimal frontend Dockerfile (TanStack Start / Vite + Nitro node-server)
# Copy to: Dockerfile (repository root)
# Pair with: docker/entrypoint.sh (see docker-entrypoint.sh.example)
#
# Requirements (basic):
# - Non-root user
# - HEALTHCHECK on /health
# - Documented PORT (8080)
# - linux/arm64 friendly base (bookworm-slim / glibc)
# - No secrets in the image (bake only public VITE_* URLs)

FROM node:22-bookworm-slim AS build

WORKDIR /app

ENV npm_config_audit=false \
    npm_config_fund=false \
    npm_config_update_notifier=false \
    NITRO_PRESET=node-server

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.ts tsconfig.json components.json ./
COPY public ./public
COPY src ./src
COPY docker ./docker

ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=${VITE_API_URL}
# Prod bake: pass CORP_API_URL from deploy/published-hosts.env via GHA build-args

RUN npm run build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0

WORKDIR /app

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /app --shell /usr/sbin/nologin app

COPY --from=build /app/.output ./.output
COPY --from=build /app/docker ./docker

RUN chmod +x /app/docker/entrypoint.sh \
    && chown -R app:app /app

USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/app/docker/entrypoint.sh"]

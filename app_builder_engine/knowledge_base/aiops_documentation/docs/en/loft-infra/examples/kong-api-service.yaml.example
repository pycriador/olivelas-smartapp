# Example — Kong external API service (infra-prod)
# Target: gateways/infra-prod/external/cross/services/<api>-service.yaml

services:
- name: <api-name>-service
  protocol: https
  host: <api-name>.cross.loft-prod.io
  port: 443
  path: /
  retries: 0
  connect_timeout: 5000
  read_timeout: 60000
  write_timeout: 60000
  tags:
  - impact_level:5
  - squad:squad-ai

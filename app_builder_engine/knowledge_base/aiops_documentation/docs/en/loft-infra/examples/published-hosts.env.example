# Canonical published URLs (template)

# Copy to: deploy/published-hosts.env in the app repo.
# Public hosts only — never put secrets here.
#
# Consumers (typical):
#   - .github/workflows/prod-k8s-deployment-front.yml (Vite bake)
#   - scripts/vault/push_secrets.py (production URL hints)
#   - CORS / ops cutovers
#
# Gateway pattern (DataForge / Central):
#   Front → kong-corp (JumpCloud + Netskope ALB)
#   API   → kong-external (+ ip-restriction Netskope)
# Do NOT put the SPA API on kong-corp: Cognito 302 on OPTIONS breaks CORS.

CORP_FRONT_URL=https://<app>.loft-corp.com.br
CORP_API_URL=https://<api-name>.loft-corp.com.br

CROSS_FRONT_URL=https://<front-name>.cross.loft-prod.io
CROSS_API_URL=https://<api-name>.cross.loft-prod.io

# SSR / unknown-host fallback baked as VITE_API_URL (prefer corp public API).
FRONT_BAKE_API_URL=https://<api-name>.loft-corp.com.br
